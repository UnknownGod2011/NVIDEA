<Window x:Class="Nvidea.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NVIDEA" Height="840" Width="800" MinHeight="680" MinWidth="660"
        WindowStartupLocation="CenterScreen" Loaded="ResearchWindow_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="NVIDEA" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Ctrl+Shift+Space invokes from anywhere on Windows" Opacity="0.72" Margin="0,2,0,12"/>
        </StackPanel>

        <TextBox x:Name="PromptBox" Grid.Row="1" MinHeight="86" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 ToolTip="Ask NVIDEA or prefix with research:"/>

        <Grid Grid.Row="2" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="ModeBox" Width="110" SelectedIndex="0">
                <ComboBoxItem Content="Auto"/>
                <ComboBoxItem Content="Chat"/>
                <ComboBoxItem Content="Research"/>
            </ComboBox>
            <CheckBox x:Name="ClipboardCheck" Grid.Column="1" Content="Allow clipboard context"
                      VerticalAlignment="Center" Margin="14,0,0,0"/>
            <TextBlock x:Name="ContextText" Grid.Column="2" VerticalAlignment="Center"
                       Margin="14,0" TextTrimming="CharacterEllipsis" Opacity="0.65"/>
            <Button x:Name="StopButton" Grid.Column="3" Content="Emergency stop" Padding="12,6"
                    Click="StopButton_Click" IsEnabled="False" Margin="0,0,8,0"/>
            <Button x:Name="InvokeButton" Grid.Column="4" Content="Run" Padding="20,6"
                    Click="InvokeButton_Click" IsDefault="True"/>
        </Grid>

        <Border Grid.Row="3" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Browser" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="BrowserUrlBox" Grid.Column="1" Text="https://example.com"
                         ToolTip="Credential-free browser action demo target"/>
                <Button x:Name="AuditStatusButton" Grid.Column="2" Content="Audit status" Margin="10,0,0,0"
                        Padding="12,5" Click="AuditStatusButton_Click"
                        ToolTip="Show payload-free local audit retention and pruning status"/>
                <Button x:Name="BrowserButton" Grid.Column="3" Content="Open safely" Margin="8,0,0,0"
                        Padding="14,5" Click="BrowserButton_Click"/>
            </Grid>
        </Border>

        <Border x:Name="DownloadPanel" Grid.Row="4" BorderThickness="1" CornerRadius="6" Padding="10"
                Margin="0,0,0,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DownloadPanelTitleText" Text="Verified download retained in quarantine" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DownloadSummaryText" Margin="0,3,14,0" TextWrapping="Wrap" Opacity="0.72"/>
                    <TextBlock Text="Export requires an exact destination approval. Discard permanently removes only NVIDEA's retained quarantine copy after a separate exact approval."
                               Margin="0,3,14,0" TextWrapping="Wrap" FontSize="11" Opacity="0.58"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="DownloadReviewButton" Content="Review &amp; export" Padding="14,5"
                            Click="DownloadReviewButton_Click"/>
                    <Button x:Name="DownloadDiscardButton" Content="Discard copy" Padding="14,5" Margin="0,6,0,0"
                            Click="DownloadDiscardButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="RecoveryPanel" Grid.Row="5" BorderThickness="1" CornerRadius="6" Padding="10"
                Margin="0,0,0,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Interrupted browser work detected" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RecoverySummaryText" Margin="0,3,14,0" TextWrapping="Wrap" Opacity="0.72"/>
                    <TextBlock Text="Recovery only inspects fresh page evidence. NVIDEA will never auto-retry an ambiguous side effect."
                               Margin="0,3,14,0" TextWrapping="Wrap" FontSize="11" Opacity="0.58"/>
                </StackPanel>
                <Button x:Name="RecoveryButton" Grid.Column="1" Content="Inspect evidence" Padding="14,5"
                        VerticalAlignment="Center" Click="RecoveryButton_Click"/>
            </Grid>
        </Border>

        <Border x:Name="ResearchPanel" Grid.Row="6" BorderThickness="1" CornerRadius="6" Padding="10"
                Margin="0,0,0,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Durable Nemotron + Tavily research" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ResearchStatusText" Text="No durable research job yet." Margin="0,3,14,0"
                               TextWrapping="Wrap" Opacity="0.72"/>
                    <TextBlock x:Name="ResearchCloudStatusText"
                               Text="Cloud execution is locked until the live Nebius deployment contract is proven."
                               Margin="0,3,14,0" TextWrapping="Wrap" FontSize="11" Opacity="0.68"/>
                    <TextBlock Text="Only coarse stage telemetry is shown here. Saved questions, source contents, URLs, checkpoint payloads, provider IDs, approvals, and provider errors stay out of status UI. Remote work is never replayed locally."
                               Margin="0,3,14,0" TextWrapping="Wrap" FontSize="11" Opacity="0.58"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="ResearchStartButton" Content="Start durable research" Padding="14,5"
                            Click="ResearchStartButton_Click"/>
                    <Button x:Name="ResearchResumeButton" Content="Resume next step" Padding="14,5" Margin="0,6,0,0"
                            Click="ResearchResumeButton_Click" IsEnabled="False"/>
                    <Button x:Name="ResearchReconcileButton" Content="Reconcile Nebius state" Padding="14,5" Margin="0,6,0,0"
                            Click="ResearchReconcileButton_Click" IsEnabled="False"
                            ToolTip="Provider-aware reconciliation only; never replays ambiguous remote work locally."/>
                    <Button x:Name="ResearchCancelButton" Content="Cancel" Padding="14,5" Margin="0,6,0,0"
                            Click="ResearchCancelButton_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBox x:Name="OutputBox" Grid.Row="7" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>

        <DockPanel Grid.Row="8" Margin="0,10,0,0">
            <TextBlock Text="Status:" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Text="Idle" Margin="6,0,0,0"/>
            <TextBlock Text="Clipboard is never sent unless the checkbox is enabled." DockPanel.Dock="Right"
                       Opacity="0.58"/>
        </DockPanel>
    </Grid>
</Window>