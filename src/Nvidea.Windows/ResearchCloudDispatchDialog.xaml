<Window x:Class="Nvidea.Windows.ResearchCloudDispatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approve Nebius research stage" Height="520" Width="660"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Run this research stage on Nebius?" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="This approval is one-shot and applies only to the exact durable checkpoint shown below."
                       Margin="0,5,0,16" TextWrapping="Wrap" Opacity="0.72"/>
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Job" FontWeight="SemiBold" Margin="0,0,14,7"/>
                <TextBlock x:Name="JobIdText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,7"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Stage" FontWeight="SemiBold" Margin="0,0,14,7"/>
                <TextBlock x:Name="StageText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,7"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Checkpoint" FontWeight="SemiBold" Margin="0,0,14,0"/>
                <TextBlock x:Name="CheckpointText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="What leaves this device" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,12" TextWrapping="Wrap"
                           Text="The current durable research checkpoint is encrypted on-device to the pinned worker public key, then uploaded to the configured Nebius Object Storage transport. The Serverless control plane receives an opaque work-item identifier and bounded lifecycle metadata, not the plaintext checkpoint."/>

                <TextBlock Text="What may incur cost" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,12" TextWrapping="Wrap"
                           Text="Approving can create one Nebius Serverless job for this stage. The remote worker may also invoke the configured Nemotron and Tavily providers for that stage, so cloud and provider usage may incur cost."/>

                <TextBlock Text="Safety boundary" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,12" TextWrapping="Wrap"
                           Text="Research classified as containing private OS-local data is never eligible for this action. Approval is not saved, reused, or broadened to later stages. If the durable checkpoint changes while this dialog is open, dispatch is rejected and must be reviewed again."/>
            </StackPanel>
        </ScrollViewer>

        <CheckBox x:Name="AcknowledgeCheck" Grid.Row="3" Margin="0,14,0,0"
                  Checked="AcknowledgeCheck_Changed" Unchecked="AcknowledgeCheck_Changed">
            <TextBlock TextWrapping="Wrap"
                       Text="I approve this exact job/checkpoint for one Nebius Serverless dispatch and understand the encrypted cloud-data boundary and potential usage cost."/>
        </CheckBox>

        <DockPanel Grid.Row="4" Margin="0,18,0,0">
            <TextBlock Text="No authorization is created unless you confirm." VerticalAlignment="Center" Opacity="0.64"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Cancel" Width="90" Margin="10,0,8,0" Click="Deny_Click" IsCancel="True"/>
                <Button x:Name="ApproveButton" Content="Approve once" Width="120" Click="Approve_Click"
                        IsDefault="True" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
